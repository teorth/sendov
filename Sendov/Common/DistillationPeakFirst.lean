private lemma gap1H_identity (x y : ℝ) :
    gap1H x y = (BernsteinCert.coeffTree gap1Coefficients 0).eval x y := by
  simp only [gap1H, SH, CH, XH, VH, NH, PH, WH, t4]
  simp only [gap1Coefficients, BernsteinCert.coeffTree_eval_cons,
    BernsteinCert.coeffTree_eval_nil, List.length_cons, List.length_nil, Nat.cast_ofNat]
  ring1

lemma gap1_identity (a : ℝ) :
    ((
      215197256322241735579900134833764013819745741784572601318359375 : ℕ) : ℝ) * gap1 a =
      (BernsteinCert.coeffTree gap1Coefficients 0).eval (a - 2) (17 - a) := by
  rw [← gap1H_eval]
  exact gap1H_identity (a - 2) (17 - a)

lemma gap1_pos {a : ℝ} (ha : a ∈ Set.Icc (2) (17)) : 0 < gap1 a := by
  exact BernsteinCert.coeffs_pos gap1Coefficients
    (by norm_num) (by norm_num) ha (by decide) (by decide)
    (gap1_identity a)

lemma gap1_eq (a : ℝ) :
    gap1 a = budget1 a * denominator1 a - numerator1 a := by
  unfold gap1 budget1 denominator1
  ring

lemma peak1_lt_budget {a : ℝ} (ha : 2 ≤ a) (h17 : a ≤ 17) :
    (259 / 12500) * distillRatio a *
        distillRationalExpPeak a (distillPeakRate1 a) (distillPeakShift1 a) <
      budget1 a := by
  apply (peak1_le_four ha).trans_lt
  apply (div_lt_iff₀ (denominator1_pos ha)).mpr
  have h := gap1_pos ⟨ha, h17⟩
  rw [gap1_eq] at h
  linarith

