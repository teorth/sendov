import Sendov.Common.DistillationPeakAlgebra
import Sendov.Common.BernsteinList

/-!
# An affine budget for the first rational peak

The complete degree-53 identity below proves the fourth-order Taylor majorant
strictly below `(431 - 3 a) / 2500` on `[2,17]`.
The list is the existing raw homogeneous coefficient format, not sampled data.
Long literals use hexadecimal only where decimal would exceed the line limit.
-/

namespace Sendov.PeakClosure

def gap1 (a : ℝ) : ℝ :=
  31250 * (431 - 3 * a) * S a ^ 3 * C a ^ 3 * t4 (X a) (V a) - numerator1 a

/- Low-degree homogenizations avoid expanding interval powers of degree 53. -/
private def SH (x y : ℝ) : ℝ :=
  5 * x ^ 0 * y ^ 1 +
    20 * x ^ 1 * y ^ 0

private lemma SH_eval (a : ℝ) :
    SH (a - (2)) ((17) - a) = (15 : ℝ) ^ 1 * S a := by
  unfold SH S
  ring1

private def NH (x y : ℝ) : ℝ :=
  746 * x ^ 0 * y ^ 2 +
    5932 * x ^ 1 * y ^ 1 +
    11711 * x ^ 2 * y ^ 0

private lemma NH_eval (a : ℝ) :
    NH (a - (2)) ((17) - a) = (15 : ℝ) ^ 2 * N a := by
  unfold NH N
  ring1

private def PH (x y : ℝ) : ℝ :=
  388 * x ^ 0 * y ^ 3 +
    5394 * x ^ 1 * y ^ 2 +
    24474 * x ^ 2 * y ^ 1 +
    36343 * x ^ 3 * y ^ 0

private lemma PH_eval (a : ℝ) :
    PH (a - (2)) ((17) - a) = (15 : ℝ) ^ 3 * P a := by
  unfold PH P
  ring1

private def WH (x y : ℝ) : ℝ :=
  9742 * x ^ 0 * y ^ 3 +
    123546 * x ^ 1 * y ^ 2 +
    520266 * x ^ 2 * y ^ 1 +
    727087 * x ^ 3 * y ^ 0

private lemma WH_eval (a : ℝ) :
    WH (a - (2)) ((17) - a) = (15 : ℝ) ^ 3 * W a := by
  unfold WH W
  ring1

private def CH (x y : ℝ) : ℝ :=
  24132872 * x ^ 0 * y ^ 7 +
    814421384 * x ^ 1 * y ^ 6 +
    11345681292 * x ^ 2 * y ^ 5 +
    85126993720 * x ^ 3 * y ^ 4 +
    373029172870 * x ^ 4 * y ^ 3 +
    957053482512 * x ^ 5 * y ^ 2 +
    1332925738034 * x ^ 6 * y ^ 1 +
    777699749327 * x ^ 7 * y ^ 0

private lemma CH_eval (a : ℝ) :
    CH (a - (2)) ((17) - a) = (15 : ℝ) ^ 7 * C a := by
  unfold CH C
  ring1

private def XH (x y : ℝ) : ℝ :=
  4759936 * x ^ 0 * y ^ 7 +
    326665252 * x ^ 1 * y ^ 6 +
    6025627956 * x ^ 2 * y ^ 5 +
    51603922010 * x ^ 3 * y ^ 4 +
    237247357010 * x ^ 4 * y ^ 3 +
    597611142156 * x ^ 5 * y ^ 2 +
    761351011627 * x ^ 6 * y ^ 1 +
    367047183361 * x ^ 7 * y ^ 0

private lemma XH_eval (a : ℝ) :
    XH (a - (2)) ((17) - a) = (15 : ℝ) ^ 7 * X a := by
  unfold XH X
  ring1

private def VH (x y : ℝ) : ℝ := 9 * PH x y * WH x y

private lemma VH_eval (a : ℝ) :
    VH (a - 2) (17 - a) = 15 ^ 6 * V a := by
  simp only [VH, PH_eval, WH_eval, V]
  ring1

private def gap1H (x y : ℝ) : ℝ :=
  31250 * (425 * y + 380 * x) * SH x y ^ 3 * CH x y ^ 3 *
      t4 (XH x y) ((x + y) * VH x y) -
    259 * NH x y * (2 * y + 17 * x) ^ 3 * VH x y ^ 6 *
      (6723 * (x + y) * VH x y + 5416 * CH x y) * (x + y) ^ 5

private lemma gap1H_eval (a : ℝ) :
    gap1H (a - 2) (17 - a) = ((
      215197256322241735579900134833764013819745741784572601318359375 : ℕ) : ℝ) * gap1 a := by
  simp only [gap1H, SH_eval, CH_eval, XH_eval, VH_eval, NH_eval, gap1, numerator1, t4]
  ring1

