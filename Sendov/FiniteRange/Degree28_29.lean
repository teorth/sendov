/-!
# The batch 28 to 29

`Sendov.R_le_batch` bounds every `R n α` for `28 ≤ n ≤ 29` by the elementary part and
moment at `n₀ = 28` together with the prefactor at `n₁ = 29`, so one moment and one
certificate serve all 2 degrees.  The certificate has degree 26, set by `n₀` rather
than `n₁`.

Feasibility at `n₀` is proved rather than assumed: for `n ≥ 36` it follows from
`0 ≤ α ≤ 17`, since `A - c²` increases with `n`.  This matters because feasibility propagates
*upward* in `n`, so it could not be inherited from the hypothesis at `n`.
-/

-- Generated numerals cannot be wrapped, so the long-line linter is off in this file.
set_option linter.style.longLine false
set_option maxRecDepth 4000000

namespace Sendov

namespace B28_29

lemma M_lo : M 28 = 27 := by norm_num [M]

lemma M_hi : M 29 = 28 := by norm_num [M]

lemma A_lo (α : ℝ) : A 28 α = 1 - 2 * α / 27 := by rw [A, M]; push_cast; ring

lemma A_hi (α : ℝ) : A 29 α = 1 - 2 * α / 28 := by rw [A, M]; push_cast; ring

lemma c_lo {α : ℝ} (hα : 0 ≤ α) : c 28 α = (162 + 21 * α - 2 * α ^ 2) / (54 * (3 + α)) := by
  have h3 : (3 : ℝ) + α ≠ 0 := (three_add_pos hα).ne'
  rw [c, M]
  push_cast
  field_simp
  ring

/-- `c` is nonnegative at `n₀` on the batch's `α`-range.  This replaces feasibility at `n₀`,
which for `n₀ < 36` does not follow from `α ≤ 17`. -/
lemma c_lo_nonneg {α : ℝ} (hα : 0 ≤ α) (hU : α ≤ 14) : 0 ≤ c 28 α := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  rw [c_lo hα]
  apply div_nonneg _ (by positivity)
  nlinarith [mul_nonneg hα (sub_nonneg.2 hU), sq_nonneg α]

