7 + 13165011207751367740633403433981725749824494296875 * α ^ 12 * (15 - α) ^ 16 + 40931653416291075198328442361012806391694992643125 * α ^ 13 * (15 - α) ^ 15 + 104936099346045749439240355737362583910582002551250 * α ^ 14 * (15 - α) ^ 14 + 218605526114400884612386873561624396579818747067500 * α ^ 15 * (15 - α) ^ 13 + 364544768185120783615020401898669737526038946860625 * α ^ 16 * (15 - α) ^ 12 + 479686011445303946308298171035582326066907836556875 * α ^ 17 * (15 - α) ^ 11 + 491421915359135714614282850386451786914114000492500 * α ^ 18 * (15 - α) ^ 10 + 389161288470744666432388567554714822581024179398750 * α ^ 19 * (15 - α) ^ 9 + 244558897556532361649184200629954946613489703141875 * α ^ 20 * (15 - α) ^ 8 + 139992773266086273600697845417718983669371612533125 * α ^ 21 * (15 - α) ^ 7 + 93042859490049901489480348991956175393389715291250 * α ^ 22 * (15 - α) ^ 6 + 69299238884896976481539054996360074995454890772500 * α ^ 23 * (15 - α) ^ 5 + 43491785146541891064576495824222890234435540966875 * α ^ 24 * (15 - α) ^ 4 + 19249688128515085853018716648633058220873114065625 * α ^ 25 * (15 - α) ^ 3 + 5426365264657811094720994999869461719092174416250 * α ^ 26 * (15 - α) ^ 2 + 847744461331358174965504508366152817665302528000 * α ^ 27 * (15 - α) ^ 1 + 51950222508646395464079311308157550857404416000 * α ^ 28 := by
