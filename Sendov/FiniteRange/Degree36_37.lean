theorem pev_Nmomc (α : ℝ) :
    pev Nmomc α = pev (wsum Lc 0 (qrow (gg0 36) (gg1 36) (gg2 36) 16)) α := by
  refine pev_moment_eq_of_packed_bounds 36 16 Lc betac tauc Nmomc
    (by norm_num [Lc]) (by norm_num [betac]) (by norm_num [tauc]) ?_ ?_
    (by decide) (by decide) (by rfl) α
  · norm_num [gg0, gg1, gg2, l1, betac, tauc]
  · norm_num [gg0, gg1, gg2, l1, Lc, betac]

theorem integral_lo (α : ℝ) (hα : 0 ≤ α) :
    (∫ t in (0 : ℝ)..1, t ^ 3 * Q 36 α t ^ 16)
      = pev Nmomc α / ((Lc : ℝ) * (2 * M 36 * (3 + α)) ^ 16) :=
  integral_moment_packed 36 16 (by norm_num) α hα Lc (by norm_num [Lc]) Nmomc
    (by decide) (pev_Nmomc α)

