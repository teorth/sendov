theorem pev_Nmomc (α : ℝ) :
    pev Nmomc α = pev (wsum Lc 0 (qrow (gg0 40) (gg1 40) (gg2 40) 18)) α := by
  refine pev_wsum_eq_of_packed (gg0 40) (gg1 40) (gg2 40) 18 55 Lc betac
    tauc Nmomc (by norm_num [betac]) (by norm_num [tauc]) ?_ ?_ ?_ ?_ ?_ ?_ α
  · refine rowZ_bound (gg0 40) (gg1 40) (gg2 40) 18 3 betac tauc
      (by norm_num [betac]) (by simp) (by simp) (by simp) ?_
    norm_num [gg0, gg1, gg2, l1, betac, tauc]
  · decide
  · refine wsum_bound (gg0 40) (gg1 40) (gg2 40) 18 Lc betac
      (by norm_num [Lc]) ?_
    norm_num [gg0, gg1, gg2, l1, Lc, betac]
  · decide
  · exact wsum_length_le Lc _ 0
      (qrow_entry_length_le (gg0 40) (gg1 40) (gg2 40) 3 (by simp) (by simp) (by simp) 18)
  · rfl

theorem integral_lo (α : ℝ) (hα : 0 ≤ α) :
    (∫ t in (0 : ℝ)..1, t ^ 3 * Q 40 α t ^ 18)
      = pev Nmomc α / ((Lc : ℝ) * (2 * M 40 * (3 + α)) ^ 18) :=
  integral_moment_packed 40 18 (by norm_num) α hα Lc (by norm_num [Lc]) Nmomc
    (by decide) (pev_Nmomc α)

