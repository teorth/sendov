/-- **The batch `44 ≤ n ≤ 45`.** -/
theorem finite_range {n : ℕ} (h0 : 44 ≤ n) (h1 : n ≤ 45) {α : ℝ}
    (hα : 0 ≤ α) (_hα' : α ≤ 17) (hfeas : c n α ^ 2 ≤ A n α) : R n α < 1 := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  have hMn := alpha_le_half_M (n := n) (by omega) hfeas
  -- feasibility caps α at M n / 2, which for a low batch is sharper than the ambient α ≤ 17
  have hUn : α ≤ 17 := by
    have hcast : ((n : ℕ) : ℝ) ≤ (45 : ℝ) := by exact_mod_cast h1
    have hMle : M n ≤ (45 : ℝ) - 1 := by simp only [M]; linarith
    linarith [_hα']
  have hid : (1 : ℝ) / 6 + 1 / (4 * (3 + α)) + 1 / (2 * 43) + 1 / (4 * 43 * (3 + α))
      + (1 - 2 * α / 44) ^ 2 * 45 * 44 * (45 - 2) / (4 * (3 + α))
        * (pev Nmomc α / ((Lc : ℝ) * (2 * 43 * (3 + α)) ^ 20))
