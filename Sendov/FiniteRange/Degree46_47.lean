/-- **The batch `46 ≤ n ≤ 47`.** -/
theorem finite_range {n : ℕ} (h0 : 46 ≤ n) (h1 : n ≤ 47) {α : ℝ}
    (hα : 0 ≤ α) (_hα' : α ≤ 17) (hfeas : c n α ^ 2 ≤ A n α) : R n α < 1 := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  have hMn := alpha_le_half_M (n := n) (by omega) hfeas
  -- feasibility caps α at M n / 2, which for a low batch is sharper than the ambient α ≤ 17
  have hUn : α ≤ 17 := by
    have hcast : ((n : ℕ) : ℝ) ≤ (47 : ℝ) := by exact_mod_cast h1
    have hMle : M n ≤ (47 : ℝ) - 1 := by simp only [M]; linarith
    linarith [_hα']
  have hb := R_le_batch (n₀ := 46) (n := n) (n₁ := 47) (by norm_num) h0 h1 hα
    (c_lo_nonneg hα hUn) hfeas
  rw [show ((46 : ℕ) : ℝ) - 4 = 42 by norm_num] at hb
  rw [show (42 : ℝ) / 2 = ((21 : ℕ) : ℝ) by norm_num] at hb
  simp only [Real.rpow_natCast] at hb
  rw [integral_lo α hα, M_lo, M_hi, A_hi] at hb
  push_cast at hb
  have hid : (1 : ℝ) / 6 + 1 / (4 * (3 + α)) + 1 / (2 * 45) + 1 / (4 * 45 * (3 + α))
      + (1 - 2 * α / 46) ^ 2 * 47 * 46 * (47 - 2) / (4 * (3 + α))
