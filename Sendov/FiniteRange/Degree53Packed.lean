import Sendov.FiniteRange.PackBridge

/-!
# Degree fifty-three: the moment, without ever computing the row

The numerically worst degree, and the first where the bounds are discharged by the general
lemmas rather than by `decide`.  Nothing here computes `qrow`: the coefficient bound comes
from `Sendov.l1row_qrow`, the entry-length bound from `Sendov.qrow_entry_length_le`, the row
length from `Sendov.qrow_length`, and the packed magnitude from `Sendov.abs_pevZ_le`.  The
only computation the kernel performs is one integer exponentiation and forty-nine digit
extractions.
-/

-- Generated numerals cannot be wrapped, so the long-line linter is off in this file.
set_option linter.style.longLine false
set_option maxRecDepth 1000000

namespace Sendov

/-- `lcm (4 .. 52)`. -/
def L53 : ℤ := 3099044504245996706400

/-- Kronecker base for the coefficient polynomials in `α`; exceeds twice every coefficient
of the moment numerator, which `Sendov.wsum_bound` bounds by `L * 1544 ^ 24`. -/
def beta53 : ℤ := 208830011639048571679172119093843847246029862674636395003776181764817937746163202350283645308108801

/-- Kronecker base for the row; exceeds twice every α-packed entry, which
`Sendov.rowZ_bound` bounds by `1544 ^ 24 * beta53 ^ 73`. -/
def tau53 : ℤ := 

