lemma M_lo : M 64 = 63 := by norm_num [M]

lemma M_hi : M 69 = 68 := by norm_num [M]

lemma A_lo (α : ℝ) : A 64 α = 1 - 2 * α / 63 := by rw [A, M]; push_cast; ring

lemma A_hi (α : ℝ) : A 69 α = 1 - 2 * α / 68 := by rw [A, M]; push_cast; ring

lemma c_lo {α : ℝ} (hα : 0 ≤ α) : c 64 α = (378 + 57 * α - 2 * α ^ 2) / (126 * (3 + α)) := by
  have h3 : (3 : ℝ) + α ≠ 0 := (three_add_pos hα).ne'
  rw [c, M]
  push_cast
  field_simp
  ring

/-- `c` is nonnegative at `n₀` on the batch's `α`-range.  This replaces feasibility at `n₀`,
which for `n₀ < 36` does not follow from `α ≤ 17`. -/
lemma c_lo_nonneg {α : ℝ} (hα : 0 ≤ α) (hU : α ≤ 17) : 0 ≤ c 64 α := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  rw [c_lo hα]
  apply div_nonneg _ (by positivity)
  nlinarith [mul_nonneg hα (sub_nonneg.2 hU), sq_nonneg α]

