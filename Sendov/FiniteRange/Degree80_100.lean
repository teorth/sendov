import Sendov.FiniteRange.PackBridge

/-!
# The batch 80 to 100

`Sendov.R_le_batch` bounds every `R n α` for `80 ≤ n ≤ 100` by the elementary part and
moment at `n₀ = 80` together with the prefactor at `n₁ = 100`, so one moment and one
certificate serve all 21 degrees.  The certificate has degree 78, set by `n₀` rather
than `n₁`.

Feasibility at `n₀` is proved rather than assumed: for `n ≥ 36` it follows from
`0 ≤ α ≤ 17`, since `A - c²` increases with `n`.  This matters because feasibility propagates
*upward* in `n`, so it could not be inherited from the hypothesis at `n`.
-/

-- Generated numerals cannot be wrapped, so the long-line linter is off in this file.
set_option linter.style.longLine false
set_option maxRecDepth 4000000

namespace Sendov

namespace B80_100

lemma M_lo : M 80 = 79 := by norm_num [M]

lemma M_hi : M 100 = 99 := by norm_num [M]

lemma A_lo (α : ℝ) : A 80 α = 1 - 2 * α / 79 := by rw [A, M]; push_cast; ring

lemma A_hi (α : ℝ) : A 100 α = 1 - 2 * α / 99 := by rw [A, M]; push_cast; ring

lemma c_lo {α : ℝ} (hα : 0 ≤ α) : c 80 α = (474 + 73 * α - 2 * α ^ 2) / (158 * (3 + α)) := by
  have h3 : (3 : ℝ) + α ≠ 0 := (three_add_pos hα).ne'
  rw [c, M]
  push_cast
  field_simp
  ring

/-- `c` is nonnegative at `n₀` on the batch's `α`-range.  This replaces feasibility at `n₀`,
which for `n₀ < 36` does not follow from `α ≤ 17`. -/
lemma c_lo_nonneg {α : ℝ} (hα : 0 ≤ α) (hU : α ≤ 17) : 0 ≤ c 80 α := by
  have h3 : (0 : ℝ) < 3 + α := three_add_pos hα
  rw [c_lo hα]
  apply div_nonneg _ (by positivity)
  nlinarith [mul_nonneg hα (sub_nonneg.2 hU), sq_nonneg α]

