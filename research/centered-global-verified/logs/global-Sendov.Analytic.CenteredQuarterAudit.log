Sendov.CenteredQuarter.actual_quarter_facts (q : Multiset ℂ) (hm : 7 ≤ q.card) (a : ℝ) (μ : ℂ) (ha0 : 0 < a)
  (ha1 : a < 1) (hmean : q.sum = ↑q.card * μ) (hq : ∀ z ∈ q, ‖z‖ ≤ 1) (hx0 : -1 ≤ μ.re) (hx1 : μ.re ≤ 1)
  (hp : Sendov.PaperPolar.RawPolar q.card a μ.re) (hl : Sendov.PaperPolar.lambda q.card a ≤ 1 / 4) :
  1 - a ≤ 1 / 28 ∧
    155 / 162 ≤ ‖μ‖ ∧
      Sendov.PaperPolar.b a μ.re ≤ 1 / 13 ∧
        Sendov.PaperCentered.variance (Multiset.map (fun z ↦ z - μ) q) ≤ 1 / 13 ∧
          Sendov.PaperCentered.variance (Multiset.map (fun z ↦ z - μ) q) ≤ ↑q.card * (1 - a) / 3 ∧ ‖1 - ↑a * μ‖ ≤ 5 / 18
Sendov.CenteredQuarter.actual_C_quarter_budget (q : Multiset ℂ) (hm : 7 ≤ q.card) (a : ℝ) (μ : ℂ) (ha0 : 0 < a)
  (ha1 : a < 1) (hmean : q.sum = ↑q.card * μ) (hq : ∀ z ∈ q, ‖z‖ ≤ 1) (hx0 : -1 ≤ μ.re) (hx1 : μ.re ≤ 1)
  (hp : Sendov.PaperPolar.RawPolar q.card a μ.re) (hl : Sendov.PaperPolar.lambda q.card a ≤ 1 / 4)
  (htail :
    ∑ k ∈ Finset.Ico 3 (q.card + 1),
        Sendov.PaperCenteredBound.C q.card k (Sendov.PaperCentered.variance (Multiset.map (fun z ↦ z - μ) q)) /
            (↑(q.card.choose k) * ‖μ‖ ^ k) *
          ‖Sendov.PaperCentered.H q.card k (↑a * μ)‖ ≤
      Sendov.CenteredQuarter.chordTail (↑q.card) a ‖μ‖
        (Sendov.PaperCentered.variance (Multiset.map (fun z ↦ z - μ) q))) :
  Sendov.PaperCenteredBound.majorant_Efin (Multiset.map (fun z ↦ z - μ) q) μ (↑a * μ) +
      Sendov.PaperCentered.Gamma (Multiset.map (fun z ↦ z - μ) q) μ ≤
    1 - a * ‖μ‖ - 79 * (1 - a) / 504
def Sendov.CenteredQuarter.chordTail : ℝ → ℝ → ℝ → ℝ → ℝ :=
fun m a u v ↦ 9 * a ^ 4 * u * √(v ^ 3) / ((13 / 18) ^ 4 * √(m * (m - 1) * (m - 2)))
