Sendov.CenteredBand.C_near_fullpolar_band_of_certificate (q : Multiset ℂ) (L U p : ℕ) (a : ℝ) (μ : ℂ) (X I tau : ℝ)
  (hL : 7 ≤ L) (hLp : L = 2 * p + 3) (hLm : L ≤ q.card) (hmU : q.card ≤ U) (ha0 : 9 / 10 ≤ a) (ha1 : a < 1)
  (hmean : q.sum = ↑q.card * μ) (hq : ∀ z ∈ q, ‖z‖ ≤ 1)
  (hp : 1 ≤ ‖∫ (t : ℝ) in 0..1, (Multiset.map (fun z ↦ ↑a + ↑t * (1 - ↑a ^ 2) * z) q).prod‖) (hX0 : 0 < X)
  (hhalf : 1 / 2 ≤ X ^ 2) (hX1 : X ≤ 19 / 20) (hx : X ≤ μ.re) (htau0 : 0 ≤ tau)
  (hI : Sendov.CenteredBand.curvedIntegral p X ≤ I) (hsquare : Sendov.CenteredBand.tailSquare U X I ≤ tau ^ 2)
  (hdelta : 0 < Sendov.CenteredBand.margin (↑L) (↑U) X (Sendov.CenteredBand.BConstant p U X) tau) :
  Sendov.CenteredActualTail.majorantTail (Multiset.map (fun z ↦ z - μ) q) μ (↑a * μ) ≤
      tau * Sendov.PaperCentered.variance (Multiset.map (fun z ↦ z - μ) q) ∧
    Sendov.PaperCenteredBound.majorant_Efin (Multiset.map (fun z ↦ z - μ) q) μ (↑a * μ) +
          Sendov.PaperCentered.Gamma (Multiset.map (fun z ↦ z - μ) q) μ ≤
        1 - a * ‖μ‖ - Sendov.CenteredBand.margin (↑L) (↑U) X (Sendov.CenteredBand.BConstant p U X) tau * (1 - a) ∧
      Sendov.PaperCenteredBound.majorant_Efin (Multiset.map (fun z ↦ z - μ) q) μ (↑a * μ) +
          Sendov.PaperCentered.Gamma (Multiset.map (fun z ↦ z - μ) q) μ <
        1 - a * ‖μ‖
